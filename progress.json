 "skipped": {
  "bdd1ce5a8b": "उत्तर कुंजी वर्तमान स्थिति के अनुसार गलत है।",
  "9295535462": "प्रश्न में राष्ट्रीय एकता दिवस (31 अक्टूबर) पूछा गया है, जबकि उत्तर 29 अगस्त (राष्ट्रीय खेल दिवस) दिया गया है।",
  "1f3fa7b1a1": "विकल्प (a) और (b) में गणितीय समीकरण फॉन्ट और सुपरस्क्रिप्ट की खराबी के कारण विकृत (garbled) हैं।",
  "a7974e9db7": "प्रश्न त्रुटिपूर्ण है क्योंकि दिए गए सभी विकल्प पशु ऊतक (एपिथीलियम ऊतक के प्रकार) हैं, जबकि प्रश्न 'क्या पशु ऊतक नहीं है' पूछता है।",
  "9540234d13": "प्रश्न में बायोस्फीयर रिजर्व (WNBR) पूछा गया है, जबकि उत्तर और व्याख्या गोवा के विश्व धरोहर स्थल (चर्च) की दी गई है। गोवा में कोई बायोस्फीयर रिजर्व नहीं है।",
  "0a83dbb7ef": "Options (b), (c), and (d) contain non-standard or garbled symbols (न्न्, घ्) which make them unclear in the context of Ohm's Law.",
  "4e8e47a123": "प्रश्न और विकल्प आपस में मेल नहीं खाते (प्रश्न बौद्ध धर्म से संबंधित है, जबकि विकल्प ईसाई धर्म/ईसा मसीह से संबंधित हैं)।",
  "4bc85f3e82": "प्रश्न 'समूह 17 का पंचम तत्व' के बारे में पूछता है, जबकि विकल्प आवर्त सारणी की संरचना (समूह, पंक्ति आदि) के बारे में हैं। प्रश्न और विकल्प मेल नहीं खाते।",
  "9a78489b9b": "गरीबी उन्मूलन (गरीबी हटाओ) मुख्य रूप से पांचवीं पंचवर्षीय योजना का प्रमुख उद्देश्य था, जबकि उत्तर कुंजी में छठी योजना दिया गया है जो विवादित और भ्रामक है।",
  "bbb262a843": "2020 की अनुमानित वृद्धि का यह आंकड़ा अब पुराना (outdated) और तथ्यात्मक रूप से त्रुटिपूर्ण है।"
 },
